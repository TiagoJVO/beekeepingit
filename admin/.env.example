# BeekeepingIT admin app — runtime configuration (Vite env vars).
#
# Copy to `.env.local` for local development: `cp .env.example .env.local`.
# NEVER commit real `.env*` files — only this example is tracked (see repo .gitignore).
# There are NO secrets here: the admin app is a PUBLIC OIDC client using Authorization
# Code + PKCE (no client secret to keep), per docs/architecture/auth.md §3.2.

# --- OIDC (identity, discovery-driven — provider-agnostic per D-7 / ADR-0016) ---

# Issuer URL. Every endpoint (authorize/token/jwks/end-session) is read from this
# issuer's `.well-known/openid-configuration` — the IdP is a swappable deployment
# detail. Local k3d dev default (Authentik application `beekeepingit`):
VITE_OIDC_ISSUER=https://auth.beekeepingit.local:8443/application/o/beekeepingit/

# Public client id registered in the IdP for the admin app. Per docs/architecture/auth.md
# §3.2 the admin app's client is `beekeepingit-admin` (public, Auth Code + PKCE). It must
# match a client provisioned in the IdP (blueprint provisioning is infra's concern).
VITE_OIDC_CLIENT_ID=beekeepingit-admin

# Redirect URI the IdP sends the user back to after login. Defaults to the app origin
# when unset; set explicitly if the app is served under a sub-path.
# VITE_OIDC_REDIRECT_URI=http://localhost:5174

# --- Platform API (app host; the admin app calls `<base>/v1/*` with a bearer token) ---
VITE_API_BASE_URL=https://app.beekeepingit.local:8443

# --- IdP self-service account page (D-7: account/password stays at the IdP) ---
# Where "Manage account" / "Change password" link out to. Config value, not derived.
VITE_ACCOUNT_URL=https://auth.beekeepingit.local:8443/if/user/#/settings
