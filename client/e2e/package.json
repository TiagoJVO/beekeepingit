{
  "name": "beekeepingit-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end test of the M0 walking-skeleton slice (#23): login → create → offline edit → sync.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "npm run typecheck && npm run format:check",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"tests/**/*.ts\" \"*.ts\"",
    "format": "prettier --write \"tests/**/*.ts\" \"*.ts\"",
    "test": "playwright test",
    "install-browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3"
  }
}
